# Banco de Dados (PostgreSQL via Docker)
DATABASE_URL="postgresql://nota_user:nota_pass@localhost:5432/nota_db"

# Better Auth
BETTER_AUTH_SECRET="gere-um-secret-com-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"
