# Configuração do Banco de Dados
# Para MySQL local (recomendado para produção)
DATABASE_URL="mysql://usuario:senha@localhost:3306/notas_fiscais"

# Para SQLite (desenvolvimento)
# DATABASE_URL="file:./database.sqlite"

# NextAuth.js
NEXTAUTH_SECRET="cole-aqui-um-secret-super-seguro-gerado-aleatoriamente"
NEXTAUTH_URL="http://localhost:3000"

# APIs Externas (opcional)
BRASIL_API_URL="https://brasilapi.com.br/api"

# Configurações de Email (futuro)
# EMAIL_SERVER_HOST="smtp.gmail.com"
